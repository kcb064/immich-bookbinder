{
  "name": "@bookbinder/pages",
  "version": "0.1.0",
  "private": true,
  "description": "React components that draw book pages. Shared by the editor, the public viewer and the server-side print renderer.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./print": "./src/print.tsx"
  },
  "scripts": { "typecheck": "tsc --noEmit", "build": "tsc --noEmit", "test": "vitest run" },
  "dependencies": {
    "@bookbinder/layout": "workspace:*",
    "@bookbinder/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
