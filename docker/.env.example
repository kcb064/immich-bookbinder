# immich-bookbinder environment
# Copy to .env next to compose.yaml (Dockge: paste into the stack's .env panel).
# Lines starting with # are comments. Do not quote values.

# --- Required -----------------------------------------------------------------

# Encrypts secrets at rest (Immich API key, Lulu credentials, optional Claude
# key) inside the SQLite database and signs session cookies. 64 hex chars.
# Generate one:   openssl rand -hex 32
# Changing it later makes stored secrets unreadable; you would re-enter them.
SECRET_KEY=

# Admin login. Set exactly one of the two.
#   ADMIN_PASSWORD       plain text, hashed in memory at startup (simplest).
#   ADMIN_PASSWORD_HASH  an argon2 PHC string ($argon2id$v=19$...), for people
#                        who do not want the plain password in a file.
# Produce a hash with the image itself (argon2 ships in the server's node_modules):
#   docker run --rm ghcr.io/kcb064/immich-bookbinder:latest \
#     node -e "require('argon2').hash(process.argv[1]).then(console.log)" -- 'your password'
ADMIN_PASSWORD=change-me
#ADMIN_PASSWORD_HASH=

# --- Recommended ----------------------------------------------------------------

# The URL people (and Lulu) use to reach this app from the internet, no trailing
# slash. Used for share links, the QR code page, and the PDF URLs Lulu downloads
# when you order. Behind Cloudflare Tunnel this is your tunnel hostname.
# Without it, share links are built from the request's Host header and Lulu
# ordering is disabled (export + manual upload still works).
PUBLIC_URL=https://books.example.com

# Time zone for job timestamps, chapter dates and logs (IANA name).
TZ=America/New_York

# --- Optional -------------------------------------------------------------------

# Set to true only when the admin UI is behind Cloudflare Access. The server then
# accepts the Cf-Access-Authenticated-User-Email header as an admin login instead
# of the password. Never enable this if the container is reachable without going
# through Cloudflare, because anyone could send that header.
TRUST_CF_ACCESS=false

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Set by the image; override only if you know why -----------------------------
# PORT=3080          listening port inside the container (compose maps 3080:3080)
# HOST=0.0.0.0       bind address
# DATA_DIR=/data     persistent data directory (the ./data volume)
# WEB_DIST=/app/web  built web UI served by the server
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright   where Chromium headless shell lives
