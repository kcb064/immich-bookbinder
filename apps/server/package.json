{
  "name": "@bookbinder/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API for immich-bookbinder: auth, settings, Immich proxy, books.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "generate": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts && openapi-typescript ../../specs/lulu-openapi.yml -o src/lulu/generated/lulu.d.ts",
    "generate:lulu": "openapi-typescript ../../specs/lulu-openapi.yml -o src/lulu/generated/lulu.d.ts",
    "prebuild": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts && openapi-typescript ../../specs/lulu-openapi.yml -o src/lulu/generated/lulu.d.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "pretypecheck": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts && openapi-typescript ../../specs/lulu-openapi.yml -o src/lulu/generated/lulu.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@bookbinder/layout": "workspace:*",
    "@bookbinder/pages": "workspace:*",
    "@bookbinder/scoring": "workspace:*",
    "@bookbinder/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openapi-fetch": "^0.17.0",
    "p-limit": "^7.3.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
