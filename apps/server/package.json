{
  "name": "@bookbinder/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API for immich-bookbinder: auth, settings, Immich proxy, books.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "generate": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts",
    "prebuild": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "pretypecheck": "openapi-typescript ../../specs/immich-openapi.json -o src/immich/generated/immich.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bookbinder/layout": "workspace:*",
    "@bookbinder/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
